<!-- logement.ejs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Page de Logement</title>
</head>
<body>
    <h1><%= logement.titre %></h1>
    <p><%= logement.ville %></p>
    <!-- Feuille de style Leaflet -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <!-- Script JavaScript Leaflet -->
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <div id="map" style="height: 400px;"></div>

    <% if (logement.lat && logement.lon) { %>
      <script>
        const map = L.map('map').setView([<%= logement.lat %>, <%= logement.lon %>], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        L.marker([<%= logement.lat %>, <%= logement.lon %>])
          .addTo(map)
          .bindPopup("<%= logement.titre %>");
      </script>
    <% } %>





    <a href="/">Retour à l'accueil</a>
</body>
</html>
