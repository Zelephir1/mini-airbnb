    </section>
    <main id="video-section">
        <div class="section-logement">
            <% logementAccueil.forEach(logement => { %>
              <div class="logement">
                <img src="<%= logement.image %>" class="images" alt="<%= logement.titre %>">
                
                <div class="offre-logement">
                  <div class="details-logement">
                    <a href="/logement/<%= logement.id %>" class="titre-logement">
                      <%= logement.titre %>
                    </a>
                    <a href="/logement/<%= logement.id %>" class="hote-logement">
                      <%= logement.hote %>
                    </a>
                    <a href="/logement/<%= logement.id %>" class="disponibilite-logement">
                      <%= logement.disponibilite %>
                    </a>
                    <a href="/logement/<%= logement.id %>" class="prix-logement">
                      <%= logement.prix %> &euro; par nuit
                    </a>
                  </div>
                  <div class="note-logement">
                    <p>&#9733;<%= logement.note %></p>
                  </div>
                </div>
              </div>
            <% }) %>
        </div>                            
    </main>
  <footer>
    <p>
        This project is a cloned work and
        a recreation of YouTube's design
    </p>
  </footer>      
  </body>
